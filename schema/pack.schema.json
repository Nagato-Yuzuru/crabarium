{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nagato-Yuzuru/crabarium/blob/main/schema/pack.schema.json",
  "title": "crabarium character pack",
  "type": "object",
  "required": [
    "formatVersion",
    "name",
    "author",
    "license",
    "grid",
    "palette",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1,
      "description": "The pack format version. This schema is version 1."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
      "description": "The pack name that `/crabarium pack <name>` selects."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "An SPDX license expression, for example MIT."
    },
    "attribution": {
      "type": "string",
      "maxLength": 1000,
      "description": "Where the art comes from."
    },
    "notice": {
      "type": "string",
      "maxLength": 1000,
      "description": "A notice that the README and the pack list show."
    },
    "grid": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "palette": {
      "$ref": "#/$defs/palette"
    },
    "anchors": {
      "$ref": "#/$defs/anchors",
      "description": "The anchors of the root (the whole figure): points on the grid where groups and parts attach, for example head. An anchor name is unique in the pack."
    },
    "figure": {
      "type": "object",
      "description": "The root node as a channel, \"figure\". Its variants are whole-figure drawings; a variant with covers draws in place of the groups.",
      "additionalProperties": false,
      "properties": {
        "variants": {
          "$ref": "#/$defs/variants"
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "The body, in groups that a motion can move, swap, or hide. A group is at a point of the grid, or on an anchor of another group, which is then its parent; moving or hiding a group moves or hides the groups on it. The groups are drawn in this order.",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
        "not": {
          "const": "figure"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "Where the group is on the grid. A group has at, or anchor and pivot."
          },
          "anchor": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
            "description": "The anchor of another group that the pivot goes to."
          },
          "pivot": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "The point of the group, from its top left, that goes on the anchor."
          },
          "anchors": {
            "$ref": "#/$defs/anchors",
            "description": "Anchors on this group, from its top left. An anchor name is unique in the pack."
          },
          "rows": {
            "$ref": "#/$defs/rows"
          },
          "variants": {
            "$ref": "#/$defs/variants"
          }
        }
      }
    },
    "parts": {
      "type": "object",
      "description": "Parts by slot (hat, held, back), then by name. They are drawn after the groups.",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "additionalProperties": {
          "type": "object",
          "required": [
            "anchor",
            "pivot",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
              "description": "The anchor that the pivot goes to."
            },
            "pivot": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "The point of the part, from its top left, that goes on the anchor."
            },
            "rows": {
              "$ref": "#/$defs/rows"
            },
            "palette": {
              "$ref": "#/$defs/palette"
            },
            "variants": {
              "$ref": "#/$defs/variants"
            },
            "motion": {
              "type": "object",
              "required": [
                "fps",
                "loop",
                "frames"
              ],
              "additionalProperties": false,
              "properties": {
                "fps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "loop": {
                  "type": "boolean",
                  "description": "true plays the frames again; false holds the last frame."
                },
                "frames": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/partFrame"
                  }
                }
              },
              "description": "The motion of the part itself. It names nothing outside the part, so it is the same on each body."
            }
          }
        }
      }
    },
    "motions": {
      "type": "object",
      "description": "Motions by name. A motion with the name of a built-in motion (walk, bob, float, swing) replaces it.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "fps",
          "loop",
          "frames"
        ],
        "additionalProperties": false,
        "properties": {
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "loop": {
            "type": "boolean",
            "description": "true plays the frames again; false holds the last frame."
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/frame"
            }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "description": "The motion for each character state. A state with no motion shows the still character.",
      "additionalProperties": false,
      "properties": {
        "entering": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "working": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "idle": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "finished": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "failed": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        },
        "leaving": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
        }
      }
    },
    "roles": {
      "type": "object",
      "description": "The outfits of each role. The roles are explorer, reviewer, builder, tester, planner, researcher. An agent of a role gets one of its outfits, picked by weight; the same agent always gets the same one.",
      "propertyNames": {
        "type": "string",
        "pattern": "^(explorer|reviewer|builder|tester|planner|researcher)$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "$ref": "#/$defs/outfit"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "object",
          "description": "The part that each slot shows when no rule selects one.",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
          }
        }
      }
    }
  },
  "$defs": {
    "outfit": {
      "type": "object",
      "required": [
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "$ref": "#/$defs/selection"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "How often this outfit is picked, against the others of the role. The default is 1."
        }
      }
    },
    "selection": {
      "type": "object",
      "description": "A part name for each slot.",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      }
    },
    "palette": {
      "type": "object",
      "description": "One character for each color. \".\" is transparent and cannot be a key.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[!-~]$",
        "not": {
          "const": "."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "description": "A color as #rrggbb."
      },
      "maxProperties": 64
    },
    "rows": {
      "type": "array",
      "description": "Pixel rows, top first. Each character is a palette key or \".\" for transparent.",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "anchors": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "description": "[x, y] in pixels from the top left."
      }
    },
    "variants": {
      "type": "object",
      "description": "Other drawings of the same node, by name; \"base\" is the node's own rows. A frame swap or a pack.css channel value selects one.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
        "not": {
          "const": "base"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "description": "Pixel rows, top first. Each character is a palette key or \".\" for transparent.",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          {
            "type": "object",
            "required": [
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "rows": {
                "type": "array",
                "description": "Pixel rows, top first. Each character is a palette key or \".\" for transparent.",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "anchors": {
                "$ref": "#/$defs/anchors",
                "description": "Where the anchors of the node are in this drawing, from its top left. With covers, it can also place the anchors of the groups that it covers."
              },
              "covers": {
                "type": "boolean",
                "description": "true: the drawing includes the groups on this node, so they are not drawn."
              }
            }
          }
        ]
      }
    },
    "frame": {
      "type": "object",
      "description": "One frame of a body motion. A target is a group, a part slot, or \"*\" for the whole character.",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "object",
          "description": "Moves targets. The offsets of \"*\" and of a target add together.",
          "propertyNames": {
            "type": "string",
            "pattern": "^(\\*|[a-zA-Z][a-zA-Z0-9-]{0,31})$"
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -32,
                "maximum": 32
              },
              {
                "type": "integer",
                "minimum": -32,
                "maximum": 32
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "[dx, dy] in whole pixels."
          }
        },
        "swap": {
          "type": "object",
          "description": "Draws a group, a part slot, or \"figure\" with one of its variants, or \"base\".",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
          }
        },
        "hide": {
          "type": "array",
          "description": "Groups and slots that this frame does not draw.",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
          }
        },
        "palette": {
          "$ref": "#/$defs/palette",
          "description": "Colors that replace palette colors for this frame, in each palette."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "How many ticks this frame holds. The default is 1."
        }
      }
    },
    "partFrame": {
      "type": "object",
      "description": "One frame of a part motion.",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -32,
              "maximum": 32
            },
            {
              "type": "integer",
              "minimum": -32,
              "maximum": 32
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "[dx, dy] in whole pixels."
        },
        "swap": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
          "description": "Draws the part with one of its variants."
        },
        "hide": {
          "type": "boolean"
        },
        "palette": {
          "$ref": "#/$defs/palette",
          "description": "Colors that replace palette colors for this frame."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "How many ticks this frame holds. The default is 1."
        }
      }
    }
  }
}
