{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      ["parent", "sibling", "index"]
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [".claude-plugin/types/", "pnpm-lock.yaml", "hooks/packs.generated.ts", "schema/pack.schema.json"]
}
