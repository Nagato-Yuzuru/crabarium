{
  "$schema": "../../schema/pack.schema.json",
  "formatVersion": 1,
  "name": "minimal",
  "author": "crabarium contributors",
  "license": "MIT",
  "attribution": "Original art for crabarium. Use it as the template for your own pack.",
  "grid": {
    "width": 16,
    "height": 8
  },
  "palette": {
    "o": "#e4572e",
    "d": "#a33b1f",
    "k": "#1b1b1b"
  },
  "anchors": {
    "head": [8, 2],
    "handL": [1, 2],
    "handR": [14, 2]
  },
  "groups": {
    "clawL": {
      "at": [0, 1],
      "rows": ["oo", "oo", ".o"]
    },
    "clawR": {
      "at": [14, 1],
      "rows": ["oo", "oo", "o."]
    },
    "shell": {
      "at": [2, 2],
      "rows": ["..oooooooo..", ".oooooooooo.", "oooooooooooo", "oddddddddddo"]
    },
    "eyes": {
      "at": [5, 3],
      "rows": ["k....k"]
    },
    "legsA": {
      "at": [3, 6],
      "rows": ["o.o", "o.o"]
    },
    "legsB": {
      "at": [10, 6],
      "rows": ["o.o", "o.o"]
    }
  },
  "parts": {
    "hat": {
      "cap": {
        "anchor": "head",
        "pivot": [3, 2],
        "rows": ["..bb..", "bbbbbb"],
        "palette": {
          "b": "#3b6fd6"
        }
      }
    }
  },
  "defaults": {
    "parts": {}
  }
}
