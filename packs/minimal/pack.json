{
  "$schema": "../../schema/pack.schema.json",
  "formatVersion": 1,
  "name": "minimal",
  "author": "crabarium contributors",
  "license": "MIT",
  "attribution": "Original art for crabarium. Use it as the template for your own pack.",
  "grid": {
    "width": 16,
    "height": 8
  },
  "palette": {
    "o": "#e4572e",
    "d": "#a33b1f",
    "k": "#1b1b1b"
  },
  "anchors": {
    "head": [8, 2],
    "handL": [1, 2],
    "handR": [14, 2]
  },
  "groups": {
    "clawL": {
      "at": [0, 1],
      "rows": ["oo", "oo", ".o"]
    },
    "clawR": {
      "at": [14, 1],
      "rows": ["oo", "oo", "o."]
    },
    "shell": {
      "at": [2, 2],
      "rows": ["..oooooooo..", ".oooooooooo.", "oooooooooooo", "oddddddddddo"]
    },
    "eyes": {
      "at": [5, 3],
      "rows": ["k....k"],
      "variants": {
        "shut": ["d....d"]
      }
    },
    "legsA": {
      "at": [3, 6],
      "rows": ["o.o", "o.o"]
    },
    "legsB": {
      "at": [10, 6],
      "rows": ["o.o", "o.o"]
    }
  },
  "parts": {
    "hat": {
      "cap": {
        "anchor": "head",
        "pivot": [3, 2],
        "rows": ["..bb..", "bbbbbb"],
        "palette": {
          "b": "#3b6fd6"
        }
      },
      "wig": {
        "anchor": "head",
        "pivot": [3, 2],
        "rows": ["wwwwww", "w....w"],
        "palette": {
          "w": "#f2f2f2"
        }
      }
    },
    "held": {
      "lens": {
        "anchor": "handR",
        "pivot": [0, 2],
        "rows": ["ll", "ll", "k."],
        "palette": {
          "l": "#9fd3ff"
        }
      },
      "flask": {
        "anchor": "handR",
        "pivot": [0, 2],
        "rows": [".g", "gg", "gg"],
        "palette": {
          "g": "#5fd068"
        }
      }
    }
  },
  "motions": {
    "walk": {
      "fps": 6,
      "loop": true,
      "frames": [
        {
          "offset": {
            "legsA": [0, -1]
          }
        },
        {
          "offset": {
            "legsB": [0, -1]
          }
        }
      ]
    },
    "slump": {
      "fps": 4,
      "loop": false,
      "frames": [
        {
          "offset": {
            "clawL": [0, 1],
            "clawR": [0, 1]
          },
          "swap": {
            "eyes": "shut"
          }
        },
        {
          "offset": {
            "clawL": [0, 2],
            "clawR": [0, 2]
          },
          "swap": {
            "eyes": "shut"
          },
          "palette": {
            "o": "#b0573d"
          }
        }
      ]
    }
  },
  "roles": {
    "explorer": [
      {
        "parts": {
          "held": "lens"
        }
      }
    ],
    "researcher": [
      {
        "parts": {
          "held": "lens",
          "hat": "cap"
        }
      }
    ],
    "reviewer": [
      {
        "parts": {
          "hat": "wig"
        }
      }
    ],
    "builder": [
      {
        "parts": {
          "hat": "cap"
        }
      }
    ],
    "tester": [
      {
        "parts": {
          "held": "flask"
        }
      }
    ],
    "planner": [
      {
        "parts": {
          "hat": "cap"
        },
        "weight": 1
      },
      {
        "parts": {
          "hat": "wig"
        },
        "weight": 1
      }
    ]
  },
  "defaults": {
    "parts": {}
  }
}
