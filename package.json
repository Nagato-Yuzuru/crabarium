{
  "name": "crabarium",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "claude --plugin-dir .",
    "gen": "node scripts/gen.ts",
    "check": "vp check && actionlint && node scripts/gen.ts --check",
    "fix": "vp check --fix",
    "validate": "claude plugin validate .",
    "test": "claude plugin test .",
    "verify": "pnpm check && pnpm validate && pnpm test"
  },
  "devDependencies": {
    "@adobe/css-tools": "4.5.0",
    "@anthropic-ai/claude-code": "2.1.316",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "css-what": "8.0.0",
    "vite-plus": "1.3.0"
  }
}
